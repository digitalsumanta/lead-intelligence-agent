# Production settings for docker-compose.prod.yml. Copy to .env.production on the server, fill in,
# and keep it private (chmod 600). Never commit .env.production.
# docker-compose.prod.yml derives DATABASE_URL, APP_ENV=production, CORS_ORIGINS and
# OUTREACH_UNSUBSCRIBE_BASE_URL from the values below.

# --- Public address -------------------------------------------------------------------------
DOMAIN=leads.example.com
PUBLIC_URL=https://leads.example.com
# Let's Encrypt contact for certificate expiry notices.
ACME_EMAIL=you@example.com

# --- Database (internal only) ------------------------------------------------------------------
POSTGRES_DB=lead_agent
POSTGRES_USER=lead_agent
# Long random URL-safe value, e.g. python -c "import secrets;print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- Secrets -------------------------------------------------------------------------------------
# Automation/scripts only; never give to a browser.
API_AUTH_TOKEN=
API_AUTH_USER_ID=automation
# Must be the SAME key used to encrypt the provider keys you migrate from the old database.
CREDENTIAL_ENCRYPTION_KEY=
# Must stay the same as before, or unsubscribe links in already-sent e-mails stop working.
OUTREACH_UNSUBSCRIBE_SECRET=

# --- AI and enrichment ---------------------------------------------------------------------------
AI_DEFAULT_PROVIDER=gemini
AI_GEMINI_ENABLED=true
AI_GEMINI_MODEL=gemini-2.5-flash
AI_GEMINI_API_KEY=
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
PAGESPEED_ENABLED=false

# --- Outreach ------------------------------------------------------------------------------------
OUTREACH_DISPATCH_ENABLED=true
OUTREACH_CANARY_MODE=true
OUTREACH_CANARY_ALLOWED_DOMAINS=mindartdigital.com
OUTREACH_EMAIL_ENABLED=true
OUTREACH_EMAIL_PROVIDER=RESEND
OUTREACH_RESEND_API_KEY=
OUTREACH_RESEND_FROM=Your Name <you@outreach.example.com>
# Signing secret from the Resend webhook (Webhooks -> endpoint -> Signing secret).
OUTREACH_RESEND_WEBHOOK_SECRET=

# --- E-mail compliance ---------------------------------------------------------------------------
OUTREACH_COMPLIANCE_ENFORCED=true
OUTREACH_UNSUBSCRIBE_MAILTO=unsubscribe@example.com
OUTREACH_SENDER_BUSINESS_NAME=
OUTREACH_SENDER_POSTAL_ADDRESS=

# --- Optional ------------------------------------------------------------------------------------
# METRICS_TOKEN=          # enables http://backend:8000/metrics on the internal network
# SENTRY_DSN=
BACKUP_TIME=02:00           # UTC
BACKUP_RETENTION_DAYS=14

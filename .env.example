# ==============================================================================
# Lead Intelligence Agent - Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to .env in the repository root for local execution:
#   cp .env.example .env
#
# SECURITY & SAFETY:
# - All values below are non-secret safe placeholders.
# - Never commit real credentials, API keys, or production connection strings.
# - OUTREACH_DISPATCH_ENABLED is false by default to prevent live dispatch.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# For Docker Compose: backend and worker use the internal service hostname 'database:5432'.
# For local bare-metal execution: replace 'database' with 'localhost'.
DATABASE_URL=postgresql+asyncpg://lead_agent:replace-with-url-safe-password@database:5432/lead_agent
POSTGRES_DB=lead_agent
POSTGRES_USER=lead_agent
POSTGRES_PASSWORD=replace-with-secure-local-password

# ------------------------------------------------------------------------------
# Application API Authentication
# ------------------------------------------------------------------------------
API_AUTH_TOKEN=replace-with-a-long-random-local-token
API_AUTH_USER_ID=local_api_user

# ------------------------------------------------------------------------------
# Frontend (Next.js) API Configuration
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL is accessed by the user's host browser, so it targets localhost.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TOKEN=replace-with-a-long-random-local-token
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# AI Provider Configuration (Ollama / Local LLM)
# ------------------------------------------------------------------------------
AI_DEFAULT_PROVIDER=ollama
# For Docker Compose on Windows/macOS, use host.docker.internal to reach host Ollama:
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:latest

# Cloud LLM Fallbacks (Disabled by default)
AI_GEMINI_ENABLED=false
AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_GEMINI_MODEL=gemini-2.5-flash
AI_GEMINI_TIMEOUT_SECONDS=90
AI_GEMINI_API_KEY=
AI_GEMINI_API_KEYS=

AI_OPENAI_COMPATIBLE_ENABLED=false
AI_OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
AI_OPENAI_COMPATIBLE_MODEL=local-model
AI_OPENAI_COMPATIBLE_TIMEOUT_SECONDS=90
AI_OPENAI_COMPATIBLE_API_KEY=
AI_OPENAI_COMPATIBLE_API_KEYS=

GEMINI_API_KEY=
GEMINI_API_KEYS=

# ------------------------------------------------------------------------------
# External Intelligence APIs (Disabled by default)
# ------------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_REQUEST_TIMEOUT_SECONDS=10
GOOGLE_PLACES_OPERATION=places_search_text

PAGESPEED_API_KEY=
PAGESPEED_ENABLED=false
PAGESPEED_OPERATION=run_pagespeed
PAGESPEED_REQUEST_TIMEOUT_SECONDS=45
PAGESPEED_STRATEGY=mobile
PAGESPEED_CATEGORIES=performance,accessibility,best-practices,seo

# ------------------------------------------------------------------------------
# Outreach Safety Invariants & Outbox Worker Configuration
# ------------------------------------------------------------------------------
# Master dispatch kill switch: MUST REMAIN FALSE for local testing and verification.
OUTREACH_DISPATCH_ENABLED=false
OUTREACH_CANARY_MODE=false
OUTREACH_CANARY_ALLOWED_DOMAINS=internal-test.leadintel.example.com

# Environment. production/staging disables dev-only approval shortcuts (X-Actor-Role override,
# shared approvals). These shortcuts are also forced off whenever dispatch is live without canary mode.
APP_ENV=development

# Email compliance (CAN-SPAM, Gmail/Yahoo bulk-sender rules, RFC 8058 one-click unsubscribe).
# Every outbound email gets an unsubscribe link/headers and your postal address; sends are
# blocked until this is configured. Suppressed recipients (unsubscribed, hard-bounced,
# complained) are never emailed.
OUTREACH_COMPLIANCE_ENFORCED=true
# Long random value (>= 32 chars) used to sign unsubscribe links. Keep it stable; rotating it
# invalidates links in emails already sent.
OUTREACH_UNSUBSCRIBE_SECRET=
# Public HTTPS URL where recipients can reach this backend; links point to {base}/unsubscribe/{token}.
OUTREACH_UNSUBSCRIBE_BASE_URL=
# Optional (or alternative) mailbox for "mailto:" unsubscribe requests; add replies manually via
# POST /api/email-suppressions. At least one of BASE_URL or MAILTO is required.
OUTREACH_UNSUBSCRIBE_MAILTO=
OUTREACH_SENDER_BUSINESS_NAME=
OUTREACH_SENDER_POSTAL_ADDRESS=

# Email provider configuration (Disabled by default)
OUTREACH_EMAIL_ENABLED=false
OUTREACH_EMAIL_PROVIDER=
OUTREACH_EMAIL_API_URL=
OUTREACH_EMAIL_API_KEY=
OUTREACH_EMAIL_FROM=

# WhatsApp provider configuration (Disabled by default)
OUTREACH_WHATSAPP_ENABLED=false
OUTREACH_WHATSAPP_PROVIDER=
OUTREACH_WHATSAPP_API_URL=
OUTREACH_WHATSAPP_API_KEY=
OUTREACH_WHATSAPP_PHONE_NUMBER_ID=

# ------------------------------------------------------------------------------
# Concurrency, Timeouts, and Rate Limits
# ------------------------------------------------------------------------------
MAX_CSV_BYTES=5000000
MAX_BATCH_SIZE=100
MAX_CONCURRENCY=2
REQUEST_TIMEOUT_SECONDS=300
PROVIDER_MAX_RETRIES=2
PROVIDER_BACKOFF_BASE_SECONDS=0.5
PROVIDER_BACKOFF_MAX_SECONDS=8
PROVIDER_RETRY_JITTER_SECONDS=0.2
PROVIDER_MAX_CONCURRENCY=4
PROVIDER_KEY_LEASE_SECONDS=360
PROVIDER_FAILURE_COOLDOWN_SECONDS=0.5
PROVIDER_RATE_LIMIT_COOLDOWN_SECONDS=60
PROVIDER_QUOTA_COOLDOWN_SECONDS=3600
